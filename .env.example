# Copy to .env and fill secrets. Keep .env chmod 600.

# Baidu AI Studio remote PaddleOCR API token.
# Required only for scanned/non-extractable PDFs routed to remote PaddleOCR-VL.
# This project does not use local PaddlePaddle or local PaddleOCR inference.
BAIDU_PADDLEOCR_TOKEN=

# MinerU Precision Extract API token.
# Required only for MinerU API conversion jobs.
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch

# Zotero Web API key with personal-library write and file permissions.
# Required for uploading Markdown back as child attachments.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=YOUR_LIBRARY_ID
ZOTERO_LIBRARY_TYPE=users

# Local paths and APIs.
OCR_OUTPUT_ROOT=$HOME/Zotero/OCR_OUTPUT
ZOTERO_STORAGE=$HOME/Zotero/storage
ZOTERO_LOCAL_API=http://127.0.0.1:23119/api/users/0

# Routing policy.
# Default: selectable/born-digital books use local text extraction too.
# Set this only for special item types that should always use OCR.
FORCE_OCR_ITEM_TYPES=
TEXT_EXTRACT_SAMPLE_MIN_CHARS=600
TEXT_EXTRACT_PAGE_MIN_CHARS=80
DIRTY_TEXT_LAYER_GUARD=1
DIRTY_TEXT_MIN_SAMPLE_CHARS=1000
DIRTY_TEXT_FULLWIDTH_ALNUM_RATIO=0.03
DIRTY_TEXT_PRIVATE_USE_RATIO=0.005

# Baidu quota/safety.
MAX_OCR_PAGES_PER_RUN=10000
MAX_OCR_PAGES_PER_JOB=12
BAIDU_MAX_UPLOAD_MB=49
BAIDU_PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
BAIDU_PADDLEOCR_MODEL=PaddleOCR-VL-1.6
BAIDU_POLL_SECONDS=5

REQUEST_TIMEOUT_SECONDS=60
